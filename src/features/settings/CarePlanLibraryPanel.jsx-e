import { useMemo, useState } from 'react';
import { Icon } from '../../components/Icon/Icon';
import { Badge } from '../../components/Badge/Badge';
import { Button } from '../../components/Button/Button';
import { Input } from '../../components/Input/Input';
import { ActionButton } from '../../components/ActionButton/ActionButton';
import { SectionTitleBar } from '../../components/SectionTitleBar/SectionTitleBar';
import { WorklistShell } from '../../components/WorklistShell/WorklistShell';
import { Drawer } from '../../components/Drawer/Drawer';
import { ConfirmDialog } from '../../components/ConfirmDialog/ConfirmDialog';
import { useAppStore } from '../../store/useAppStore';
import styles from './CarePlanLibraryPanel.module.css';

// Seed templates so the library isn't empty on first load. Local-only for
// now — see the panel's note to the user about persistence.
let nextId = 3;
const INITIAL_TEMPLATES = [
  {
    id: '1',
    name: 'Type 2 Diabetes — Standard',
    conditions: ['Type 2 Diabetes', 'Hypertension'],
    goals: [
      { id: 'g1', title: 'A1C below 7%', subtitle: 'Reassess quarterly via lab draw' },
      { id: 'g2', title: 'Weight loss of 5%', subtitle: 'Track via monthly weigh-in' },
    ],
    interventions: [
      { id: 'i1', title: 'Nutrition counseling', duration: '30 min' },
      { id: 'i2', title: 'Medication adherence check-in', duration: '15 min' },
    ],
    updatedAt: new Date(Date.now() - 2 * 86400000).toISOString(),
  },
  {
    id: '2',
    name: 'CHF Post-Discharge',
    conditions: ['Congestive Heart Failure'],
    goals: [
      { id: 'g3', title: 'No readmission within 30 days', subtitle: 'Weekly weight + symptom check' },
    ],
    interventions: [
      { id: 'i3', title: 'Home health nursing visit', duration: '45 min' },
      { id: 'i4', title: 'Medication reconciliation', duration: '20 min' },
    ],
    updatedAt: new Date(Date.now() - 9 * 86400000).toISOString(),
  },
];

function formatRelative(iso) {
  if (!iso) return '—';
  const days = Math.floor((Date.now() - new Date(iso).getTime()) / 86400000);
  if (days <= 0) return 'Today';
  if (days === 1) return 'Yesterday';
  if (days < 7) return `${days}d ago`;
  return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

const COLUMNS = [
  { key: 'name', label: 'Template Name', sticky: 'left', left: 0, width: 260 },
  { key: 'conditions', label: 'Conditions', width: 260 },
  { key: 'goals', label: 'Goals', width: 90 },
  { key: 'interventions', label: 'Interventions', width: 110 },
  { key: 'updated', label: 'Last Updated', width: 130 },
  { key: 'actions', label: 'Actions', sticky: 'right', width: 100 },
];

function blankDraft() {
  return { id: null, name: '', conditionsText: '', goals: [], interventions: [] };
}

function draftFromTemplate(t) {
  return {
    id: t.id,
    name: t.name,
    conditionsText: t.conditions.join(', '),
    goals: t.goals.map(g => ({ ...g })),
    interventions: t.interventions.map(i => ({ ...i })),
  };
}

export function CarePlanLibraryPanel() {
  const showToast = useAppStore(s => s.showToast);

  const [templates, setTemplates] = useState(INITIAL_TEMPLATES);
  const [searchValue, setSearchValue] = useState('');
  const [draft, setDraft] = useState(null); // null = drawer closed
  const [deleteTarget, setDeleteTarget] = useState(null);

  const filtered = useMemo(() => {
    const q = searchValue.trim().toLowerCase();
    if (!q) return templates;
    return templates.filter(t =>
      t.name.toLowerCase().includes(q) ||
      t.conditions.some(c => c.toLowerCase().includes(q))
    );
  }, [templates, searchValue]);

  const openCreate = () => setDraft(blankDraft());
  const openEdit = (t) => setDraft(draftFromTemplate(t));
  const closeDrawer = () => setDraft(null);

  const canSave = draft?.name.trim().length > 0;

  const saveDraft = () => {
    if (!canSave) return;
    const conditions = draft.conditionsText.split(',').map(c => c.trim()).filter(Boolean);
    if (draft.id) {
      setTemplates(prev => prev.map(t => (t.id === draft.id
        ? { ...t, name: draft.name.trim(), conditions, goals: draft.goals, interventions: draft.interventions, updatedAt: new Date().toISOString() }
        : t)));
      showToast(`"${draft.name.trim()}" updated`);
    } else {
      const id = String(nextId++);
      setTemplates(prev => [...prev, {
        id, name: draft.name.trim(), conditions, goals: draft.goals, interventions: draft.interventions,
        updatedAt: new Date().toISOString(),
      }]);
      showToast(`"${draft.name.trim()}" created`);
    }
    closeDrawer();
  };

  const confirmDelete = () => {
    setTemplates(prev => prev.filter(t => t.id !== deleteTarget.id));
    showToast(`"${deleteTarget.name}" deleted`);
    setDeleteTarget(null);
  };

  const addGoal = () => setDraft(d => ({ ...d, goals: [...d.goals, { id: `g-${Date.now()}`, title: '', subtitle: '' }] }));
  const updateGoal = (id, patch) => setDraft(d => ({ ...d, goals: d.goals.map(g => (g.id === id ? { ...g, ...patch } : g)) }));
  const removeGoal = (id) => setDraft(d => ({ ...d, goals: d.goals.filter(g => g.id !== id) }));

  const addIntervention = () => setDraft(d => ({ ...d, interventions: [...d.interventions, { id: `i-${Date.now()}`, title: '', duration: '' }] }));
  const updateIntervention = (id, patch) => setDraft(d => ({ ...d, interventions: d.interventions.map(i => (i.id === id ? { ...i, ...patch } : i)) }));
  const removeIntervention = (id) => setDraft(d => ({ ...d, interventions: d.interventions.filter(i => i.id !== id) }));

  const renderRow = (t) => (
    <tr key={t.id} className={styles.row}>
      <td className={styles.tdName}>
        <button type="button" className={styles.nameLink} onClick={() => openEdit(t)}>
          {t.name}
        </button>
      </td>
      <td className={styles.tdConditions}>
        <div className={styles.chipRow}>
          {t.conditions.map(c => <Badge key={c} variant="ai-neutral" label={c} />)}
        </div>
      </td>
      <td className={styles.tdCount}>{t.goals.length}</td>
      <td className={styles.tdCount}>{t.interventions.length}</td>
      <td className={styles.tdUpdated}>{formatRelative(t.updatedAt)}</td>
      <td className={styles.tdActions} onClick={e => e.stopPropagation()}>
        <div className={styles.actionCell}>
          <ActionButton icon="solar:pen-linear" size="S" tooltip="Edit" onClick={() => openEdit(t)} />
          <div className={styles.vDivider} />
          <ActionButton icon="solar:trash-bin-trash-linear" size="S" tooltip="Delete" onClick={() => setDeleteTarget(t)} />
        </div>
      </td>
    </tr>
  );

  return (
    <div className={styles.wrapper}>
      <SectionTitleBar
        variant="titleOnly"
        title="Care Plan Library"
        actions={['search']}
        searchPlaceholder="Search templates or conditions…"
        searchValue={searchValue}
        onSearchChange={setSearchValue}
        primaryActionLabel="New Template"
        onPrimaryAction={openCreate}
      />

      <div className={styles.content}>
        <WorklistShell
          header={null}
          columns={COLUMNS}
          rows={filtered}
          renderRow={renderRow}
          emptyState={
            <div className={styles.emptyState}>
              <Icon name="solar:clipboard-list-linear" size={32} color="var(--neutral-150)" />
              <p>
                {searchValue.trim()
                  ? <>No templates match "<strong>{searchValue.trim()}</strong>".</>
                  : 'No care plan templates yet. Click "New Template" to create one.'}
              </p>
            </div>
          }
          minTableWidth={900}
        />
      </div>

      {draft && (
        <Drawer
          title={draft.id ? 'Edit Care Plan Template' : 'New Care Plan Template'}
          onClose={closeDrawer}
          secondaryAction={<Button variant="secondary" size="L" onClick={closeDrawer}>Cancel</Button>}
          primaryAction={<Button variant="primary" size="L" onClick={saveDraft} disabled={!canSave}>Save</Button>}
        >
          <div className={styles.formField}>
            <span className={styles.formLabel}>Template Name <span className={styles.required}>•</span></span>
            <Input
              value={draft.name}
              onChange={e => setDraft(d => ({ ...d, name: e.target.value }))}
              placeholder="e.g. Type 2 Diabetes — Standard"
            />
          </div>

          <div className={styles.formField}>
            <span className={styles.formLabel}>Conditions</span>
            <Input
              value={draft.conditionsText}
              onChange={e => setDraft(d => ({ ...d, conditionsText: e.target.value }))}
              placeholder="Comma-separated, e.g. Type 2 Diabetes, Hypertension"
            />
          </div>

          <div className={styles.formSection}>
            <div className={styles.formSectionHeader}>
              <span className={styles.formLabel}>Goals</span>
              <button type="button" className={styles.addRowLink} onClick={addGoal}>
                <Icon name="solar:add-circle-linear" size={14} color="var(--primary-300)" />
                Add Goal
              </button>
            </div>
            {draft.goals.map(g => (
              <div key={g.id} className={styles.listRow}>
                <Input
                  value={g.title}
                  onChange={e => updateGoal(g.id, { title: e.target.value })}
                  placeholder="Goal title"
                  className={styles.listRowTitle}
                />
                <Input
                  value={g.subtitle}
                  onChange={e => updateGoal(g.id, { subtitle: e.target.value })}
                  placeholder="Detail (optional)"
                  className={styles.listRowSubtitle}
                />
                <ActionButton icon="solar:trash-bin-trash-linear" size="S" tooltip="Remove goal" onClick={() => removeGoal(g.id)} />
              </div>
            ))}
            {draft.goals.length === 0 && <div className={styles.listEmpty}>No goals added yet.</div>}
          </div>

          <div className={styles.formSection}>
            <div className={styles.formSectionHeader}>
              <span className={styles.formLabel}>Interventions</span>
              <button type="button" className={styles.addRowLink} onClick={addIntervention}>
                <Icon name="solar:add-circle-linear" size={14} color="var(--primary-300)" />
                Add Intervention
              </button>
            </div>
            {draft.interventions.map(i => (
              <div key={i.id} className={styles.listRow}>
                <Input
                  value={i.title}
                  onChange={e => updateIntervention(i.id, { title: e.target.value })}
                  placeholder="Intervention title"
                  className={styles.listRowTitle}
                />
                <Input
                  value={i.duration}
                  onChange={e => updateIntervention(i.id, { duration: e.target.value })}
                  placeholder="Duration (e.g. 30 min)"
                  className={styles.listRowDuration}
                />
                <ActionButton icon="solar:trash-bin-trash-linear" size="S" tooltip="Remove intervention" onClick={() => removeIntervention(i.id)} />
              </div>
            ))}
            {draft.interventions.length === 0 && <div className={styles.listEmpty}>No interventions added yet.</div>}
          </div>
        </Drawer>
      )}

      {deleteTarget && (
        <ConfirmDialog
          icon="solar:danger-triangle-linear"
          iconColor="var(--status-error)"
          title={`Delete "${deleteTarget.name}"?`}
          description="This will remove the template from the library. This action cannot be undone."
          confirmLabel="Delete Template"
          variant="error"
          onCancel={() => setDeleteTarget(null)}
          onConfirm={confirmDelete}
        />
      )}
    </div>
  );
}
